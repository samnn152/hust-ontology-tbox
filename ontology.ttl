dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

prov:wasDerivedFrom a owl:ObjectProperty .

foaf:homepage a owl:ObjectProperty .

<https://samnn152.github.io/hust-ontology-tbox/> a owl:Ontology ;
    rdfs:label "HUST university ontology — public T-Box"@en,
        "Ontology đại học HUST — T-Box công khai"@vi ;
    dcterms:creator "samnn152 and project ontology contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06"^^xsd:date ;
    rdfs:comment "Đang phát triển. Thông tin còn nhiều thiếu sót. Bản công khai chỉ chứa schema; không phải ấn phẩm chính thức của HUST."@vi .

hust:AcademicMentor a owl:Class ;
    rdfs:label "Academic mentor"@en,
        "Mentor học thuật"@vi ;
