hust:CenterDeputyDirector a owl:Class ;
    rdfs:label "Deputy center director"@en,
        "Phó giám đốc trung tâm"@vi ;
    rdfs:seeAlso <https://smse.hust.edu.vn/vi/organs/> ;
    rdfs:subClassOf hust:LeadershipManagement ;
    owl:disjointWith hust:CenterDirector ;
    hust:evidenceType "legacy-public-source" ;
    hust:reference <https://smse.hust.edu.vn/vi/organs/> ;
    hust:roleFamily "LeadershipManagement" .

hust:CenterSpokesperson a owl:Class ;
    rdfs:label "Center spokesperson"@en,
        "Đầu mối phát ngôn của trung tâm"@vi ;
    rdfs:seeAlso <https://library.hust.edu.vn/vi/node/56> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hust:roleRepresentsOrganization ;
            owl:someValuesFrom hust:Organization ],
        [ a owl:Restriction ;
            owl:onProperty hust:roleContactPointFor ;
            owl:someValuesFrom hust:Organization ],
        hust:CommunicationsMedia,
        hust:Spokesperson ;
    hust:evidenceType "explicit-public-title-or-function" ;
    hust:reference <https://library.hust.edu.vn/vi/node/56> .

