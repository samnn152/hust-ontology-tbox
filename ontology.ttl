    rdfs:subClassOf hust:UniversityRelation .

hust:Building a owl:Class ;
    rdfs:label "Building"@en,
        "Toà nhà"@vi ;
    rdfs:subClassOf <http://dbpedia.org/ontology/Building>,
        hust:Facility .

hust:ExternalRelationsPartnership a owl:Class ;
    rdfs:label "External relations and partnership"@en,
