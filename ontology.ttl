hust:Alumni a owl:Class ;
    rdfs:label "Cựu người học"@vi ;
    rdfs:subClassOf hust:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hust:Person [ a owl:Restriction ;
                        owl:onProperty hust:hasUniversityRelation ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( hust:AlumniAffiliation ) ] ] ) ] .

hust:AlumniLiaison a owl:Class ;
    rdfs:label "Alumni liaison"@en,
        "Ban liên lạc cựu sinh viên"@vi ;
