    rdfs:label "Học phần"@vi ;
    rdfs:subClassOf hust:academic_AcademicEntity .

hust:academic_Role a owl:Class .

hust:Place a owl:Class ;
    rdfs:label "Place"@en,
        "Địa điểm"@vi ;
    rdfs:comment "Khai lại đúng như mô-đun People & Roles (cùng IRI). Tiêu chí định danh: hình học/vị trí."@vi ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
        schema:Place ;
    owl:hasKey ( hust:osmId ) .

hust:UniversityUnit a owl:Class ;
    rdfs:label "University Unit"@en,
        "Đơn vị thuộc đại học"@vi ;
    rdfs:comment "Mọi đơn vị thuộc đại học đều (trực tiếp hoặc bắc cầu) là đơn vị con của một đại học."@vi ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty org:subOrganizationOf ;
            owl:someValuesFrom hust:University ],
        org:OrganizationalUnit,
        hust:Organization .

hust:academic_Organization a owl:Class ;
    rdfs:subClassOf hust:academic_AcademicEntity .

hust:academic_Person a owl:Class .

hust:AdministrativeProfessional a owl:Class ;
    rdfs:label "Administrative / professional"@en,
        "Hành chính / chuyên môn"@vi ;
    rdfs:seeAlso <https://ts.hust.edu.vn/p/lien-he>,
        <https://www.hust.edu.vn/vi/su-kien-noi-bat/thong-bao-chung/thong-bao-tuyen-dung-dot-1-nam-2026-654794.html> ;
    rdfs:subClassOf hust:Role ;
    hust:evidenceType "legacy-public-source" ;
    hust:reference <https://ts.hust.edu.vn/p/lien-he>,
        <https://www.hust.edu.vn/vi/su-kien-noi-bat/thong-bao-chung/thong-bao-tuyen-dung-dot-1-nam-2026-654794.html> .

hust:Achievement a owl:Class ;
    rdfs:label "Thành tích và danh hiệu"@vi ;
    owl:disjointWith hust:Person,
        hust:UniversityRelation .

xsd:date a rdfs:Datatype .

hust:LeadershipManagement a owl:Class ;
    rdfs:label "Leadership / management"@en,
        "Lãnh đạo / quản lý"@vi ;
    rdfs:seeAlso <https://smse.hust.edu.vn/vi/organs/>,
        <https://soict.hust.edu.vn/dang-uy-truong.html> ;
    rdfs:subClassOf hust:Role ;
    hust:evidenceType "legacy-public-source" ;
    hust:reference <https://smse.hust.edu.vn/vi/organs/>,
        <https://soict.hust.edu.vn/dang-uy-truong.html> .

hust:UniversityRelation a owl:Class ;
    rdfs:label "University relation"@en,
        "Quan hệ với đại học"@vi ;
    rdfs:comment "In this ontology profile, role TYPES such as LecturerTitle are owl:Class subclasses of Role. Concrete contextual role occurrences are individuals of those classes. This intentionally differs from W3C ORG's common pattern where abstract roles are org:Role individuals."@en ;
    rdfs:seeAlso schema:Role,
        <https://www.w3.org/TR/vocab-org/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass hust:Organization ;
            owl:onProperty hust:roleAtOrganization ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty hust:isCurrent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass hust:Person ;
            owl:onProperty hust:roleHeldBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:hasKey ( hust:roleAtOrganization hust:roleHeldBy hust:roleTitleLiteral hust:startDate ) ;
    hust:reference schema:Role .

hust:Work a owl:Class ;
    rdfs:label "Assigned work"@en,
        "Công việc được giao"@vi ;
    rdfs:comment "Công việc hoặc trách nhiệm đảm nhận, ví dụ giảng dạy, nghiên cứu, điều phối học phần. Một chức danh có thể gắn với nhiều công việc."@vi ;
    rdfs:subClassOf hust:UniversityRelation ;
    owl:disjointWith hust:Affiliation .

hust:hasUniversityRelation a owl:ObjectProperty ;
    rdfs:label "Có quan hệ với đại học"@vi ;
    rdfs:domain hust:Person ;
    rdfs:range hust:UniversityRelation .

hust:Organization a owl:Class ;
    rdfs:label "Organization"@en,
        "Tổ chức"@vi ;
    rdfs:comment "Khai lại đúng như mô-đun People & Roles (cùng IRI). Tiêu chí định danh: quyết định thành lập — không phải vị trí."@vi ;
    rdfs:subClassOf org:Organization,
        schema:Organization ;
    owl:disjointWith hust:Place ;
    hust:reference <https://www.w3.org/TR/vocab-org/> .

hust:Role a owl:Class ;
    rdfs:label "Position"@en,
        "Chức danh"@vi ;
    rdfs:comment "Chức danh hoặc vị trí được bổ nhiệm/ghi nhận, ví dụ giảng viên, trưởng khoa, chuyên viên. Không đồng nhất với công việc được giao."@vi ;
    rdfs:subClassOf hust:UniversityRelation ;
    owl:disjointWith hust:Affiliation,
        hust:Work .

hust:Person a owl:Class ;
    rdfs:label "Person"@en,
        "Con người"@vi ;
    owl:disjointWith hust:UniversityRelation ;
    owl:hasKey ( hust:email ) ;
    hust:reference <https://www.w3.org/TR/vocab-org/> .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:AdministrativeArea hust:Campus hust:Facility ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:Building hust:Floor hust:Room hust:OutdoorSportsFacility hust:Gate hust:ParkingFacility ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:AcademicBuilding hust:LibraryBuilding hust:Dormitory hust:SportsBuilding hust:DiningBuilding hust:ServiceBuilding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:University hust:VocationalCollege hust:K12School ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:School hust:Faculty hust:Department hust:ResearchInstitute hust:Center hust:AdministrativeOffice hust:GoverningCouncil hust:ExecutiveBoard hust:PublishingUnit hust:ResearchLaboratory ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:EducationalOrganization hust:UniversityUnit hust:MassOrganization hust:Enterprise hust:GovernmentAgency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hust:Country hust:Province hust:Commune hust:District ) .

