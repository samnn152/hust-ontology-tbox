hust:CorporateLiaison a owl:Class ;
    rdfs:label "Corporate liaison"@en,
        "Đầu mối doanh nghiệp"@vi ;
    rdfs:seeAlso <https://www.hust.edu.vn/vi/co-cau-to-chuc-bai-viet/ban-cong-tac-sinh-vien.html>,
        <https://www.hust.edu.vn/vi/co-cau-to-chuc-bai-viet/ban-hop-tac-doi-ngoai.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hust:roleLiaisesWithOrganization ;
            owl:someValuesFrom hust:Organization ],
        hust:ExternalRelationsPartnership,
        hust:Liaison ;
    hust:evidenceType "functional-inference" ;
    hust:reference <https://www.hust.edu.vn/vi/co-cau-to-chuc-bai-viet/ban-cong-tac-sinh-vien.html>,
