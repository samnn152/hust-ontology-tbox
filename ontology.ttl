    rdfs:label "has role context"@en,
        "có ngữ cảnh vai trò"@vi ;
    rdfs:domain hust:UniversityRelation ;
    rdfs:range owl:Thing ;
    owl:inverseOf hust:isRoleContextOf ;
    hust:reference <https://www.w3.org/TR/owl-primer/> .

hust:Affiliation a owl:Class ;
    rdfs:label "Affiliation"@en,
