    hust:reference <https://www.w3.org/TR/owl2-syntax/> .

hust:AlumniNetworkCoordinator a owl:Class ;
    rdfs:label "Alumni network coordinator"@en,
        "Điều phối mạng lưới cựu sinh viên"@vi ;
